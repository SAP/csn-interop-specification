# Keep dependency versions reproducible.
package-lock=true
lockfile-version=3
save-exact=true

# Enforce supported runtimes and reject peer-dependency conflicts.
engine-strict=true
strict-peer-deps=true

# Block install lifecycle scripts; repository tasks invoke required steps explicitly.
ignore-scripts=true

# Keep install output quiet and registry requests bounded.
fund=false
update-notifier=false
fetch-retries=5
fetch-timeout=60000
strict-ssl=true
