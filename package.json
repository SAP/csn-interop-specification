{
  "$schema": "http://json.schemastore.org/package",
  "name": "@sap/csn-interop-specification",
  "version": "1.2.6",
  "description": "CSN Interop Specification.",
  "author": "SAP SE",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/csn-interop-specification.git"
  },
  "homepage": "https://sap.github.io/csn-interop-specification/",
  "files": [
    "README.md",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/generated/spec/v1"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clear": "npm run clear --workspace @sap/csn-interop-docs --",
    "build": "npm run build:spec && npm run build:docusaurus",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:docusaurus": "npm run build --workspace @sap/csn-interop-docs --",
    "generate": "spec-toolkit -c ./spec-toolkit.config.json",
    "postgenerate": "node ./scripts/copyGeneratedToDestination.js",
    "generate:check": "node scripts/check-generated-up-to-date.mjs",
    "format": "biome check --write .",
    "ci": "biome ci .",
    "lint": "biome lint .",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test 'dist/__tests__/**/*.test.js'",
    "validate:annotations": "node scripts/validate-annotations.mjs",
    "serve": "npm run serve --workspace @sap/csn-interop-docs --",
    "prestart": "npm run clear",
    "start": "npm run start --workspace @sap/csn-interop-docs --",
    "build:spec": "npm run generate && npm run build:ts",
    "test:spec": "npm run build:spec && npm run test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@open-resource-discovery/spec-toolkit": "0.9.1",
    "@types/node": "24.19.2",
    "json-schema-library": "11.6.16",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "serialize-javascript": "^7.1.4",
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "tooling/docs"
  ]
}
