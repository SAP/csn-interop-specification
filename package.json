{
  "$schema": "http://json.schemastore.org/package",
  "name": "@sap/csn-interop-specification",
  "version": "1.2.6",
  "description": "CSN Interop Specification.",
  "author": "SAP SE",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/csn-interop-specification.git"
  },
  "homepage": "https://sap.github.io/csn-interop-specification/",
  "files": [
    "README.md",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/generated/spec/v1"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clear": "docusaurus clear",
    "build": "npm run generate && npm run build:ts && npm run build:docusaurus",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:docusaurus": "docusaurus build",
    "generate": "npx @open-resource-discovery/spec-toolkit -c ./spec-toolkit.config.json",
    "postgenerate": "node ./scripts/copyGeneratedToDestination.js",
    "generate:check": "node scripts/check-generated-up-to-date.mjs",
    "format": "biome check --write .",
    "ci": "biome ci .",
    "lint": "biome lint .",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test 'dist/__tests__/**/*.test.js'",
    "validate:annotations": "node scripts/validate-annotations.mjs",
    "serve": "docusaurus serve",
    "prestart": "npm run clear",
    "start": "docusaurus start",
    "prepare": "is-ci || lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@open-resource-discovery/spec-toolkit": "0.9.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "is-ci": "4.1.0",
    "json-schema-library": "11.6.16",
    "lefthook": "2.2.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "serialize-javascript": "^7.1.4",
    "uuid": "^11.1.1"
  }
}
